# CricVision & CricTutor AI - Environment Configuration Example
# Copy this file to .env and configure your values

APP_NAME="CricVision & CricTutor AI"
ENVIRONMENT="production"
DEBUG=false

# Server Settings
HOST="0.0.0.0"
PORT=8000

# Security (NEVER commit your actual secrets to Git or expose to client)
SECRET_KEY="replace-with-a-random-64-character-string-in-production"
FORCE_HTTPS=false

# Optional Online Coaching LLM Enhancer (Leave blank for 100% offline rule engine)
GEMINI_API_KEY=""

# Database Configuration (Defaults to high-speed local SQLite with WAL mode)
DATABASE_URL="sqlite:///./cricvision.db"

# Allowed CORS Origins (comma separated or JSON list)
CORS_ORIGINS='["http://localhost:3000","http://localhost:5173","http://localhost:8000","https://cricvision.vercel.app"]'

# Upload Limits
MAX_UPLOAD_SIZE_MB=50
